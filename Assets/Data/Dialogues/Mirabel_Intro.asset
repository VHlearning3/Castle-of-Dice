  speakerPortrait: {fileID: 0}
  dialogueText: "Tss... hiljaa. Haistatko vallihaudan kitker\xE4n sammaleen? Olen
    Mirabel, yrttiparantaja. Tarvitsisin kipe\xE4sti kolme suokukkaa linnan vallihaudan
    liepeilt\xE4 rohtojani varten, mutta ep\xE4kuolleet vartijat tekev\xE4t ker\xE4\xE4misest\xE4
    liian vaarallista."
  options:
  - optionText: Voin noutaa kukat vallihaudalta.
    requiresCheck: 0
    targetDC: 10
    skillCheckDescription: 
