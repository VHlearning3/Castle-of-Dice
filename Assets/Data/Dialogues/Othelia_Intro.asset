  speakerName: Elder Othelia
  speakerPortrait: {fileID: 0}
  dialogueText: Greetings, traveler. I am Elder Othelia. Oakhaven lived in peace
    until the ancient stone castle stirred with evil. If you venture to the castle
    gates, could you search for my family's lost signet ring?
  options:
  - optionText: I will find the ring for you.
    requiresCheck: 0
    targetDC: 10
    skillCheckDescription: 
    nextNodeSuccess: {fileID: 11400000, guid: 987fe80ae9a717848a795a47b5e99846, type: 2}
    nextNodeFailure: {fileID: 0}
    combatDebuffTag: '[ACTION_ACCEPT_QUEST:quest_lost_signet_ring]'
  - optionText: Tell me about the castle's history and the King.
    requiresCheck: 0
    targetDC: 10
    skillCheckDescription: 
